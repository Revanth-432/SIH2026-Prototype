{
  "expo": {
    "name": "Artisan Linkage",
    "slug": "artisan-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "artisan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF9F5"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
