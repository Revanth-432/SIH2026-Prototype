# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Supabase PostgreSQL Database Connections (Prisma)
# Use transaction connection pooler (port 6543) for application queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.iaitqhnyouqgcmedlony.supabase.co:6543/postgres?pgbouncer=true"

# Direct connection to the database (port 5432) for Prisma CLI migrations & schema push
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.iaitqhnyouqgcmedlony.supabase.co:5432/postgres"

# Supabase Project Credentials
SUPABASE_URL="https://iaitqhnyouqgcmedlony.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Supabase Auth / JWT Configuration
# Find this in Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-from-dashboard"

# AI / ML Service Keys (Placeholders)
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
BG_REMOVAL_API_KEY="your-background-removal-api-key"
STABLE_DIFFUSION_API_KEY="your-stable-diffusion-api-key"
PHOTOROOM_API_KEY="your-photoroom-api-key"

